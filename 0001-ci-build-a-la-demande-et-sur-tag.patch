 src-tauri/tauri.conf.json   |  4 +-
 4 files changed, 90 insertions(+), 15 deletions(-)

diff --git a/.github/workflows/build.yml b/.github/workflows/build.yml
index 6d7e21b..ded840e 100644
--- a/.github/workflows/build.yml
+++ b/.github/workflows/build.yml
@@ -1,26 +1,83 @@
 # Paquets d'Abbon, dans l'ordre de priorité : Linux, Android, Windows.
-# - Lancement manuel ou push sur main : paquets disponibles en « artifacts » du workflow.
-# - Tag vX.Y.Z : en plus, brouillon de release GitHub avec tous les fichiers.
+#
+# Déclenchement :
+# - À la demande (onglet Actions → Build → Run workflow) : branche, tag ou commit en paramètre,
+#   choix des plateformes. Les paquets sont disponibles dans les « artifacts » de l'exécution.
+# - Sur un tag vX.Y.Z : les trois plateformes, puis un brouillon de release GitHub avec
+#   tous les fichiers et leurs empreintes SHA-256. Le tag doit correspondre à la version de package.json.
 #
 # Secrets facultatifs pour signer l'APK de release (sinon APK de debug) :
 #   ANDROID_KEYSTORE_BASE64, ANDROID_KEYSTORE_PASSWORD, ANDROID_KEY_ALIAS, ANDROID_KEY_PASSWORD
 name: Build
 
+run-name: Build ${{ github.event_name == 'workflow_dispatch' && inputs.ref || github.ref_name }}
+
 on:
   workflow_dispatch:
+    inputs:
+      ref:
+        description: 'Branche, tag ou commit à compiler'
+        required: true
+        default: init
+        type: string
+      linux:
+        description: 'Linux : deb, rpm, AppImage'
+        type: boolean
+        default: true
+      android:
+        description: 'Android : APK'
+        type: boolean
+        default: true
+      windows:
+        description: 'Windows : MSI, NSIS'
+        type: boolean
+        default: true
   push:
-    branches: [main]
     tags: ['v*']
 
 permissions:
   contents: write
 
+env:
+  # Référence compilée : celle choisie à la main, sinon le tag poussé.
+  BUILD_REF: ${{ github.event_name == 'workflow_dispatch' && inputs.ref || github.ref }}
+
 jobs:
+  prepare:
+    runs-on: ubuntu-24.04
+    outputs:
+      version: ${{ steps.v.outputs.version }}
+      sha: ${{ steps.v.outputs.sha }}
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          ref: ${{ env.BUILD_REF }}
+      - id: v
+        name: Version et commit
+        run: |
+          VERSION=$(node -p "require('./package.json').version")
+          SHA=$(git rev-parse --short HEAD)
+          echo "version=$VERSION" >> "$GITHUB_OUTPUT"
+          echo "sha=$SHA" >> "$GITHUB_OUTPUT"
+          echo "### Abbon $VERSION — $BUILD_REF ($SHA)" >> "$GITHUB_STEP_SUMMARY"
+      - name: Le tag correspond à la version de package.json
+        if: github.event_name == 'push'
+        run: |
+          VERSION=$(node -p "require('./package.json').version")
+          if [ "$GITHUB_REF_NAME" != "v$VERSION" ]; then
+            echo "::error::Le tag $GITHUB_REF_NAME ne correspond pas à la version v$VERSION de package.json"
+            exit 1
+          fi
+
   linux:
+    needs: prepare
+    if: github.event_name == 'push' || inputs.linux
     # Ubuntu 22.04 : glibc plus ancienne, donc AppImage compatible avec plus de distributions.
     runs-on: ubuntu-22.04
     steps:
       - uses: actions/checkout@v4
+        with:
+          ref: ${{ env.BUILD_REF }}
       - uses: actions/setup-node@v4
         with: { node-version: 22, cache: npm }
       - name: Dépendances système
@@ -35,19 +92,24 @@ jobs:
       - run: npx tauri build --bundles deb,rpm,appimage
       - uses: actions/upload-artifact@v4
         with:
-          name: abbon-linux
+          name: abbon-linux-${{ needs.prepare.outputs.version }}-${{ needs.prepare.outputs.sha }}
           path: |
             src-tauri/target/release/bundle/deb/*.deb
             src-tauri/target/release/bundle/rpm/*.rpm
             src-tauri/target/release/bundle/appimage/*.AppImage
 
   android:
+    needs: prepare
+    if: github.event_name == 'push' || inputs.android
     runs-on: ubuntu-24.04
     env:
       NDK_VERSION: 27.2.12479018
       HAS_KEYSTORE: ${{ secrets.ANDROID_KEYSTORE_BASE64 != '' }}
+      VERSION: ${{ needs.prepare.outputs.version }}
     steps:
       - uses: actions/checkout@v4
+        with:
+          ref: ${{ env.BUILD_REF }}
       - uses: actions/setup-node@v4
         with: { node-version: 22, cache: npm }
       - uses: actions/setup-java@v4
@@ -78,7 +140,6 @@ jobs:
           BT=$(ls -d "$ANDROID_SDK_ROOT"/build-tools/* | sort -V | tail -1)
           echo "$KEYSTORE" | base64 -d > "$RUNNER_TEMP/abbon.jks"
           IN=$(find src-tauri/gen/android/app/build/outputs/apk -name '*release-unsigned.apk' | head -1)
-          VERSION=$(node -p "require('./package.json').version")
           "$BT/zipalign" -f -p 4 "$IN" "$RUNNER_TEMP/aligned.apk"
           "$BT/apksigner" sign --ks "$RUNNER_TEMP/abbon.jks" --ks-pass "pass:$KS_PASS" \
             --ks-key-alias "$KEY_ALIAS" --key-pass "pass:$KEY_PASS" \
@@ -90,18 +151,21 @@ jobs:
         if: env.HAS_KEYSTORE != 'true'
         run: |
           npx tauri android build --apk --debug --ci
-          VERSION=$(node -p "require('./package.json').version")
           cp "$(find src-tauri/gen/android/app/build/outputs/apk -name '*debug.apk' | head -1)" "abbon-${VERSION}-debug.apk"
 
       - uses: actions/upload-artifact@v4
         with:
-          name: abbon-android
+          name: abbon-android-${{ needs.prepare.outputs.version }}-${{ needs.prepare.outputs.sha }}
           path: abbon-*.apk
 
   windows:
+    needs: prepare
+    if: github.event_name == 'push' || inputs.windows
     runs-on: windows-latest
     steps:
       - uses: actions/checkout@v4
+        with:
+          ref: ${{ env.BUILD_REF }}
       - uses: actions/setup-node@v4
         with: { node-version: 22, cache: npm }
       - uses: dtolnay/rust-toolchain@stable
@@ -111,14 +175,14 @@ jobs:
       - run: npx tauri build --bundles msi,nsis
       - uses: actions/upload-artifact@v4
         with:
-          name: abbon-windows
+          name: abbon-windows-${{ needs.prepare.outputs.version }}-${{ needs.prepare.outputs.sha }}
           path: |
             src-tauri/target/release/bundle/msi/*.msi
             src-tauri/target/release/bundle/nsis/*.exe
 
   release:
-    if: startsWith(github.ref, 'refs/tags/v')
-    needs: [linux, android, windows]
+    if: github.event_name == 'push' && startsWith(github.ref, 'refs/tags/v')
+    needs: [prepare, linux, android, windows]
     runs-on: ubuntu-24.04
     steps:
       - uses: actions/download-artifact@v4
@@ -127,5 +191,6 @@ jobs:
         run: cd dist && sha256sum * > SHA256SUMS.txt
       - uses: softprops/action-gh-release@v2
         with:
+          name: Abbon ${{ needs.prepare.outputs.version }}
           draft: true
           files: dist/*
