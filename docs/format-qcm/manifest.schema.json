{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "abbon-qcm"
    },
    "formatVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "kind": {
      "type": "string",
      "enum": [
        "content",
        "backup"
      ]
    },
    "app": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 50
        },
        "version": {
          "type": "string",
          "maxLength": 30
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "exportedAt": {
      "type": "string",
      "maxLength": 40
    },
    "solutions": {
      "type": "boolean"
    },
    "quizzes": {
      "maxItems": 5000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[\\w-]+$"
          },
          "file": {
            "type": "string",
            "maxLength": 200
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "file",
          "version"
        ],
        "additionalProperties": false
      }
    },
    "media": {
      "maxItems": 5000,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  },
  "required": [
    "format",
    "formatVersion",
    "kind",
    "app",
    "exportedAt",
    "solutions",
    "quizzes",
    "media"
  ],
  "additionalProperties": false
}
