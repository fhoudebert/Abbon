{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[\\w-]+$"
    },
    "categoryId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[\\w-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "title": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})?$"
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 5000
      }
    },
    "description": {
      "anyOf": [
        {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})?$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 5000
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "languages": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})?$"
      }
    },
    "level": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 100
        },
        {
          "type": "null"
        }
      ]
    },
    "tags": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 100
      }
    },
    "timeLimitSec": {
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 86400
        },
        {
          "type": "null"
        }
      ]
    },
    "passThreshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "scoring": {
      "type": "string",
      "enum": [
        "all_or_nothing",
        "partial"
      ]
    },
    "solutionVisibility": {
      "type": "string",
      "enum": [
        "never",
        "after_submit",
        "after_pass"
      ]
    },
    "shuffle": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "author": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "createdAt": {
      "type": "string",
      "maxLength": 40
    },
    "updatedAt": {
      "type": "string",
      "maxLength": 40
    },
    "questions": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[\\w-]+$"
          },
          "type": {
            "type": "string",
            "enum": [
              "single",
              "multiple",
              "short",
              "numeric"
            ]
          },
          "prompt": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})?$"
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 50000
                },
                {
                  "$ref": "#/$defs/__schema0"
                }
              ]
            }
          },
          "points": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1000
          },
          "position": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "explanation": {
            "anyOf": [
              {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})?$"
                },
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 50000
                    },
                    {
                      "$ref": "#/$defs/__schema0"
                    }
                  ]
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "choices": {
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100,
                  "pattern": "^[\\w-]+$"
                },
                "content": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})?$"
                  },
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 50000
                      },
                      {
                        "$ref": "#/$defs/__schema0"
                      }
                    ]
                  }
                },
                "correct": {
                  "type": "boolean"
                },
                "position": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "feedback": {
                  "anyOf": [
                    {
                      "type": "object",
                      "propertyNames": {
                        "type": "string",
                        "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})?$"
                      },
                      "additionalProperties": {
                        "anyOf": [
                          {
                            "type": "string",
                            "maxLength": 50000
                          },
                          {
                            "$ref": "#/$defs/__schema0"
                          }
                        ]
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "id",
                "content",
                "position"
              ],
              "additionalProperties": false
            }
          },
          "expected": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "accepted": {
                    "maxItems": 50,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 500
                    }
                  },
                  "caseSensitive": {
                    "type": "boolean"
                  },
                  "value": {
                    "type": "number"
                  },
                  "tolerance": {
                    "type": "number",
                    "minimum": 0
                  },
                  "unit": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 30
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "type",
          "prompt",
          "points",
          "position",
          "choices"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "categoryId",
    "title",
    "languages",
    "tags",
    "passThreshold",
    "scoring",
    "solutionVisibility",
    "shuffle",
    "status",
    "version",
    "createdAt",
    "updatedAt",
    "questions"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "attrs": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "maxLength": 40
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "content": {
          "maxItems": 2000,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "text": {
          "type": "string",
          "maxLength": 50000
        },
        "marks": {
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "maxLength": 40
              },
              "attrs": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "maxLength": 40
                },
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 2000
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    }
  }
}
