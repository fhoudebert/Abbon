{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "abbon-module"
    },
    "formatVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "id": {
      "type": "string",
      "maxLength": 100,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)+$"
    },
    "version": {
      "type": "string",
      "maxLength": 60
    },
    "title": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})?$"
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 5000
      }
    },
    "description": {
      "anyOf": [
        {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})?$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 5000
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "level": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 100
        },
        {
          "type": "null"
        }
      ]
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "authors": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 200
      }
    },
    "homepage": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 500,
          "pattern": "^https:\\/\\/"
        },
        {
          "type": "null"
        }
      ]
    },
    "requires": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "app": {
              "type": "string",
              "maxLength": 40
            },
            "features": {
              "maxItems": 20,
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 40
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "categories": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100,
        "pattern": "^[\\w-]+$"
      }
    },
    "quizzes": {
      "maxItems": 5000,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100,
        "pattern": "^[\\w-]+$"
      }
    },
    "sheets": {
      "anyOf": [
        {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[\\w-]+$"
          },
          "additionalProperties": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})?$"
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 50000
                },
                {
                  "$ref": "#/$defs/__schema0"
                }
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "format",
    "formatVersion",
    "id",
    "version",
    "title",
    "license",
    "authors",
    "categories",
    "quizzes"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "attrs": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "maxLength": 40
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "content": {
          "maxItems": 2000,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "text": {
          "type": "string",
          "maxLength": 50000
        },
        "marks": {
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "maxLength": 40
              },
              "attrs": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "maxLength": 40
                },
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 2000
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    }
  }
}
